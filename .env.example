# demo runs entirely locally. bedrock enables paid AWS text + image requests.
PROVIDER=demo
# The voice simulation uses a separate local conversational host and connects to the canonical MCP endpoint.
HOST_MODE=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# For another trusted LAN computer, replace loopback with its private IPv4 address.
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Adventure generation emits a whole validated story graph, so allow more time than one host turn.
OLLAMA_GENERATION_TIMEOUT_MS=120000
# By default the host uses this server's PORT over loopback. Override only for a separate local MCP service.
# RPG_MCP_URL=http://127.0.0.1:3000/mcp
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Exact external origin for a deployment/tunnel (no path):
# PUBLIC_ORIGIN=https://rpg-night.example.com
AWS_REGION=us-east-1
TEXT_MODEL_ID=amazon.nova-lite-v1:0
IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
# Prefer an IAM role or AWS profile/SSO. Optional environment credentials:
# AWS_PROFILE=rpg-night
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
