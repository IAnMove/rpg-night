{
  "name": "rpg-night",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch mcp-server/index.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json && node scripts/copy-runtime-assets.mjs",
    "start": "node dist/server/mcp-server/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "probe:host": "tsx scripts/probe-host.ts",
    "probe:host:v2": "tsx scripts/probe-host-v2.ts",
    "eval:host:v2": "tsx scripts/evaluate-host-v2.ts",
    "probe:generation": "tsx scripts/probe-generation.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
