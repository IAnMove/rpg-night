{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node"], "noEmit": true
  },
  "include": ["mcp-server/**/*.ts", "shared/**/*.ts", "web-tv/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
